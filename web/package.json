{
  "name": "homegen-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run build && npm run lint:css && node --test",
    "start": "node serve.mjs",
    "build": "node scripts/build-css.mjs",
    "build:css": "node scripts/build-css.mjs",
    "lint": "eslint .",
    "lint:css": "node scripts/lint-css.mjs",
    "watch:css": "node scripts/watch-css.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "postcss": "^8.5.28",
    "postcss-cli": "^12.0.0",
    "prettier": "^3.9.9",
    "puppeteer-core": "^25.12.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "three": "0.186.0"
  },
  "imports": {
    "#jszip": "./vendor/jszip/jszip.module.js",
    "#jspdf": "./vendor/jspdf/jspdf.es.min.js",
    "#three": "./vendor/three/three.module.js",
    "#three/*": "./vendor/three/*",
    "designer3d/tools": "../designer3d/tools/index.mjs",
    "designer3d/tools/*": "../designer3d/tools/*",
    "#designer3d/tools": "../designer3d/tools/index.mjs"
